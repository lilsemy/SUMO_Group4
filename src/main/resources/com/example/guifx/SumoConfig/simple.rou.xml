<routes>
    <!-- Vehicle type definitions -->
    <!-- Định nghĩa các loại xe -->
    <vType id="car" vClass="passenger" length="5" accel="3.5" decel="2.2" sigma="1.0" maxSpeed="10" color="red"/>
    <vType id="bus" vClass="bus" length="12" accel="2.0" decel="2.0" sigma="0.8" maxSpeed="8" color="blue"/>
    <vType id="truck" vClass="truck" length="8" accel="2.5" decel="2.0" sigma="0.9" maxSpeed="9" color="green"/>
    
    <!-- Routes -->
    <route id="r1" edges="e1 e2"/>
    <route id="r2" edges="e3 e4"/>
    
    <!-- Mixed traffic: cars, buses, and trucks -->
    <!-- Giao thông hỗn hợp: xe con, xe buýt và xe tải -->
    
    <!-- Route 1: n1 -> n3 -->
    <vehicle id="car_0" type="car" route="r1" depart="0" color="1,0,0"/>
    <vehicle id="bus_0" type="bus" route="r1" depart="1" color="0,0,1"/>
    <vehicle id="car_1" type="car" route="r1" depart="2" color="1,0,0"/>
    <vehicle id="truck_0" type="truck" route="r1" depart="3" color="0,1,0"/>
    <vehicle id="car_2" type="car" route="r1" depart="4" color="1,0,0"/>
    
    <!-- Route 2: n3 -> n1 -->
    <vehicle id="truck_1" type="truck" route="r2" depart="1" color="0,1,0"/>
    <vehicle id="car_3" type="car" route="r2" depart="3" color="1,0,0"/>
    <vehicle id="bus_1" type="bus" route="r2" depart="5" color="0,0,1"/>
    <vehicle id="car_4" type="car" route="r2" depart="7" color="1,0,0"/>
    <vehicle id="truck_2" type="truck" route="r2" depart="9" color="0,1,0"/>
    
    <!-- More traffic -->
    <vehicle id="car_5" type="car" route="r1" depart="6" color="1,0,0"/>
    <vehicle id="bus_2" type="bus" route="r2" depart="11" color="0,0,1"/>
    <vehicle id="truck_3" type="truck" route="r1" depart="8" color="0,1,0"/>
    <vehicle id="car_6" type="car" route="r2" depart="13" color="1,0,0"/>
</routes>

