<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane focusTraversable="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="914.0" prefWidth="1582.0" stylesheets="@simulation-style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.guifx.GUI">
   <children>
      <!-- Left sidebar controls (scrollable, narrower, height limited above bottom bar) -->
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefViewportWidth="220.0" styleClass="sidebar-scroll" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
         <content>
            <VBox fx:id="leftControls" prefWidth="220.0" spacing="10.0" styleClass="sidebar">
               <children>
                  <Label styleClass="label-title" text="Simulation Controls" />

                  <Slider id="simSpeedSlider" fx:id="simSpeedSlider" layoutX="337.0" layoutY="36.0" value="50.0" AnchorPane.rightAnchor="951.0" AnchorPane.topAnchor="25.0" />
                  <!-- Control Buttons -->
                  <VBox spacing="8.0" styleClass="sidebar-group">
                     <children>
                        <Button mnemonicParsing="false" onAction="#commandSpawnVehicle" prefHeight="42.0" prefWidth="220.0" styleClass="primary-button" text="Insert Car">
                           <graphic>
                              <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@proxy-image.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <ChoiceBox id="InsertionSelector" fx:id="InsertionSelector" prefHeight="28.0" prefWidth="220.0" styleClass="control-field" />
                     </children>
                  </VBox>

                  <VBox spacing="8.0" styleClass="sidebar-group">
                     <children>
                        <Button fx:id="commandFolowVehicle" mnemonicParsing="false" onAction="#commandFollowVehicle" prefHeight="42.0" prefWidth="220.0" styleClass="secondary-button" text="Follow Vehicle">
                           <graphic>
                              <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@Search.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <ChoiceBox id="vehicleSelector" fx:id="vehicleSelector" prefHeight="28.0" prefWidth="220.0" styleClass="control-field" />
                     </children>
                  </VBox>

                  <VBox spacing="8.0" styleClass="sidebar-group">
                     <children>
                        <Button mnemonicParsing="false" onAction="#commandChangeVehicleAppearance" prefHeight="42.0" prefWidth="220.0" styleClass="secondary-button" text="Change Appearance">
                           <graphic>
                              <ImageView fitHeight="34.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@appearance.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                     </children>
                  </VBox>

                  <Separator />

                  <VBox spacing="8.0" styleClass="sidebar-group">
                     <children>
                        <Label styleClass="label-filter" text="Spawning config:" />
                        <HBox spacing="6.0">
                           <children>
                              <ChoiceBox id="SpawnConfigType" fx:id="typeSpawnChoice" prefHeight="28.0" prefWidth="220.0" styleClass="control-field" />
                              <ChoiceBox id="SpawnConfigColor" fx:id="colorSpawnChoice" prefHeight="28.0" prefWidth="220.0" styleClass="control-field" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <VBox spacing="8.0" styleClass="sidebar-group">
                     <children>
                        <Label styleClass="label-filter" text="View filters:" />
                        <HBox spacing="6.0">
                           <children>
                              <ChoiceBox fx:id="vehicleTypeFilter" prefHeight="28.0" prefWidth="220.0" styleClass="control-field" />
                              <ChoiceBox fx:id="vehicleColorFilter" prefHeight="28.0" prefWidth="220.0" styleClass="control-field" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <Separator />

                  <VBox spacing="8.0" styleClass="sidebar-group">
                     <children>
                        <Label styleClass="label-tl" text="Traffic lights:" />
                        <Button mnemonicParsing="false" onAction="#commandChangePhase" prefHeight="42.0" prefWidth="220.0" styleClass="secondary-button" text="Change Phase">
                           <graphic>
                              <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@trafficlight.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <ChoiceBox id="TLSelector" fx:id="TLSelector" prefHeight="28.0" prefWidth="220.0" styleClass="control-field" />
                        <TextField id="GetDuration" fx:id="GetDuration" prefHeight="28.0" prefWidth="220.0" promptText="Duration (s)" styleClass="control-field" />
                     </children>
                  </VBox>

                  <Separator />

                  <VBox spacing="8.0" styleClass="sidebar-group">
                     <children>
                        <Label styleClass="label-filter" text="Load test:" />
                        <Button mnemonicParsing="false" onAction="#commandStressTest" prefHeight="42.0" prefWidth="220.0" styleClass="danger-button" text="Stress Test">
                           <graphic>
                              <ImageView fx:id="stressAlarmIcon" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@alarm.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <TextField fx:id="stressTestCountField" prefHeight="28.0" prefWidth="220.0" promptText="Vehicle count (1-15.000)" styleClass="control-field" />

                        <Button mnemonicParsing="false" onAction="#commandPrintCongestion" prefHeight="42.0" prefWidth="220.0" styleClass="secondary-button" text="Congestions">
                           <graphic>
                              <ImageView fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@Congestion.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>

      <!-- Center map area (scrollable, height limited above bottom bar) -->
      <VBox spacing="10.0" AnchorPane.bottomAnchor="200.0" AnchorPane.leftAnchor="270.0" AnchorPane.rightAnchor="440.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label styleClass="label-section" text="Live Simulation:" />
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" pannable="true" styleClass="map-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
               <content>
                  <StackPane fx:id="mapContainer" prefHeight="600.0" prefWidth="1100.0" styleClass="map-card">
                     <children>
                        <Canvas fx:id="backgroundCanvas" height="600.0" width="1100.0" />
                        <Pane fx:id="laneLayer" prefHeight="600.0" prefWidth="1100.0" />
                        <Pane fx:id="trafficLightLayer" prefHeight="600.0" prefWidth="1100.0" />
                        <Pane fx:id="carLayer" prefHeight="600.0" prefWidth="1100.0" />
                     </children>
                  </StackPane>
               </content>
            </ScrollPane>
         </children>
      </VBox>

      <!-- Right side bar (was bottom statistics bar) -->
      <VBox fx:id="bottomStats" prefWidth="400.0" spacing="12.0" styleClass="bottom-bar" AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <VBox spacing="6.0">
               <children>
                  <Label styleClass="label-section" text="Statistics:" />
                  <Label id="timeLabel" fx:id="timeLabel" layoutX="10.0" layoutY="43.0" text="Time in simulation: 0" />
                  <Label id="vehicleCountLabel" fx:id="vehicleCountLabel" text="Vehicles: 0" />
                  <Label id="vehicleQueuedCountLabel" fx:id="vehicleQueuedCountLabel" layoutX="10.0" layoutY="43.0" text="Queued Vehicles: 0" />
                  <Label id="avgSpeedLabel" fx:id="avgSpeedLabel" text="Avg Speed: 0 m/s" />
                  <Label id="Tl1Dur" fx:id="Tl1Dur" text="TL1: 0" />
                  <Label id="Tl2Dur" fx:id="Tl2Dur" text="TL2: 0" />
               </children>
            </VBox>

            <LineChart fx:id="speedChart" animated="false" legendVisible="true" prefHeight="300.0" prefWidth="500.0">
               <xAxis>
                  <NumberAxis label="Time (s)" side="BOTTOM" />
               </xAxis>
               <yAxis>
                  <NumberAxis label="Avg Speed (m/s)" side="LEFT" />
               </yAxis>
            </LineChart>

            <LineChart fx:id="travelTimeChart" animated="false" legendVisible="true" prefHeight="300.0" prefWidth="500.0">
               <xAxis>
                  <NumberAxis label="Time (s)" side="BOTTOM" />
               </xAxis>
               <yAxis>
                  <NumberAxis label="Avg Travel Time (s)" side="LEFT" />
               </yAxis>
            </LineChart>

            <TextArea id="consoleArea" fx:id="consoleArea" prefHeight="160.0" prefWidth="500.0" />
         </children>
      </VBox>

      <!-- Bottom bar (was right vehicle info sidebar) -->
      <HBox fx:id="rightVehicleInfo" prefHeight="160.0" spacing="12.0" styleClass="sidebar" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="270.0" AnchorPane.rightAnchor="440.0">
         <children>
            <VBox prefWidth="260.0" spacing="6.0">
               <children>
                  <Label styleClass="label-title" text="Vehicle Info" />
                  <Label fx:id="vehicleInfoHeader" styleClass="label-note" text="No vehicle selected" />
               </children>
            </VBox>

            <VBox prefWidth="260.0" spacing="6.0" styleClass="sidebar-group">
               <children>
                  <Label fx:id="vehicleInfoId" text="ID: -" />
                  <Label fx:id="vehicleInfoType" text="Type: -" />
                  <Label fx:id="vehicleInfoColor" text="Color: -" />
                  <Label fx:id="vehicleInfoSpeed" text="Speed: -" />
               </children>
            </VBox>

            <VBox prefWidth="260.0" spacing="6.0" styleClass="sidebar-group">
               <children>
                  <Label fx:id="vehicleInfoLane" text="Lane: -" />
                  <Label fx:id="vehicleInfoRoute" text="Route: -" />
                  <Label fx:id="vehicleInfoPos" text="Pos: -" />
                  <Label fx:id="vehicleInfoAngle" text="Angle: -" />
               </children>
            </VBox>
         </children>
      </HBox>

   </children>
   <styleClass>
      <String fx:value="anchor-pane" />
   </styleClass>
</AnchorPane>
